+# ROUND 5 -- GEAK_DIT_LNCFG: launch config of the fused add+LN kernel, re-swept
+# COLD (24 rotating 3.2 MB input pairs = 154 MB, so no launch reuses an
+# L2-resident buffer).  The round-3 default (8 warps, 1 stage) reads 4.37 us on
+# the real [392, 2048] shape; (4 warps, 2 stages) reads 3.59 us, -18%, and the
+# whole ranking is different from the hot sweep.  For reference the SAME 6.4 MB
+# moved by two plain torch copies costs 5.87 us, so the kernel is already past
+# the elementwise machine limit -- this is the last 18%, not a rewrite.
+# Same for the fused QK+RoPE kernel: 3.93 -> 3.67 us at 2 stages.
+_GEAK_LNCFG = _geak_flag("GEAK_DIT_LNCFG")
+_GEAK_FUSELN_WARPS = int(_geak_os.environ.get(
+    "GEAK_DIT_FUSELN_WARPS", "4" if _GEAK_LNCFG else "8"))
+_GEAK_FUSELN_STAGES = int(_geak_os.environ.get(
