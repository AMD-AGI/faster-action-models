+# ---------------------------------------------------------------------------
+# ROUND 3 -- GEAK_DIT_FUSEQK: the self-attention Q/K preparation, one kernel.
+#
+# The fused-QKV path currently spends EIGHT separate elementwise dispatches per
+# block turning the projection output into rotated q/k:
+#     torch.stack((t[:,:,0], t[:,:,1]))      cat            [2,B,S,H,D] bf16
+#     F.rms_norm(qk, (D,), None, eps)        _fused_rms_norm
+#     qk * wqk                               mul
+#     cat([-x_imag, x_real])                 neg + cat
+#     x * cos                                mul            -> fp32, 6.4 MB
+#     addcmul(., x_rot, sin)                 addcmul        -> fp32, 6.4 MB
+#     .to(bf16)                              copy
+# 8 dispatches x 18 blocks = 144 of region C's ~500, and two of the temporaries
+# are fp32 (the cos/sin tables are fp32, so the multiply promotes).
+#
+# One kernel, one program per token, does all of it: it loads the q and k rows
+# of the projection output TWICE -- once at d and once at (d + D/2) mod D, both
+# from the same cache lines -- so the RoPE "rotate half" needs no separate
+# neg/cat tensor at all, and the fp32 intermediates never reach HBM.
+#
+# NUMERICS: identical op order and identical rounding points (rms result -> bf16,
+# gain -> bf16, rope accumulated in fp32 -> bf16); only the 128-element mean-square
+# reduction order can differ from torch's, i.e. sub-ULP on an fp32 accumulator.
+# ---------------------------------------------------------------------------
+_GEAK_FUSEQK = _geak_flag("GEAK_DIT_FUSEQK")
+_geak_qkrope_cache = {}
+_GEAK_QKROPE_STAGES = 2 if _geak_flag("GEAK_DIT_LNCFG") else 1
+
+# ---------------------------------------------------------------------------
+# ROUND 5 -- GEAK_DIT_QNORM: the CROSS-attention query RMS-norm, one triton
+# kernel over whole token rows instead of one CTA per 128-element head.
+#
+# MEASURED (this box, torch.profiler, real shape [1,392,16,128] bf16):
+#   torch F.rms_norm  -> vectorized_layer_norm_kernel<BFloat16,float,true>
+#                        6272 CTAs (one per HEAD row of 128 elements = 256 B)
+#                        6.65 us for 3.2 MB of traffic = 482 GB/s, ~9x off the
+#                        HBM roofline.  The kernel is not slow, the DECOMPOSITION
+#                        is: a 256-byte row cannot amortise a CTA.
+#   triton, one program per TOKEN (392 CTAs x [16,128] tile, 4 KB/row, the 16
+#   per-head reductions done independently inside the tile) -> 2.02 us.
+# = -4.6 us x 18 blocks = -83 us/iter of pure body, at the SAME node count, so
+# it is immune to the "eager triton launch tax" argument only insofar as it
+# replaces a torch op 1:1 (5.9 us direct-launch host vs ~4-5 us for the aten
+# call) -- the device saving is 4.6 us, an order above that difference.
+#
+# NUMERICS: identical to `vectorized_layer_norm_kernel<BFloat16,float,true>` --
+# fp32 accumulation of sum(x*x), one fp32 rsqrt, gain applied in fp32, ONE
+# rounding to bf16 at the store.  Only the 128-element reduction ORDER differs.
+# ---------------------------------------------------------------------------
+_GEAK_QNORM = _geak_flag("GEAK_DIT_QNORM")
+_geak_qnorm_cache = {}
+
+if _GEAK_TRITON_OK:
+
+    @_geak_triton.jit
+    def _geak_qnorm_kernel(
+        X, W, O, eps,
+        H: _geak_tl.constexpr, D: _geak_tl.constexpr,
+    ):
+        row = _geak_tl.program_id(0)
+        h = _geak_tl.arange(0, H)
+        d = _geak_tl.arange(0, D)
+        off = h[:, None] * D + d[None, :]
+        x = _geak_tl.load(X + row * H * D + off).to(_geak_tl.float32)
+        inv = _geak_tl.rsqrt(_geak_tl.sum(x * x, 1) / D + eps)[:, None]
+        g = _geak_tl.load(W + d)[None, :].to(_geak_tl.float32)
+        _geak_tl.store(O + row * H * D + off, (x * inv * g).to(O.dtype.element_ty))
+
+
+_GEAK_QNORM_WARPS = int(_geak_os.environ.get("GEAK_DIT_QNORM_WARPS", "4"))
+
+
+def _geak_qnorm(x4, w, eps):
+    """RMS-norm over the last dim of a contiguous [B, S, H, D] tensor, affine
+    gain `w` of shape [D].  Returns a contiguous [B, S, H, D]."""
+    B, S, H, D = x4.shape
+    n = B * S
+    o = torch.empty_like(x4)
+    args = (x4, w, o, float(eps))
+    key = (n, H, D, x4.dtype)
+    if _GEAK_FUSELN_FAST:
+        if key not in _geak_qnorm_cache:
+            ck = None
+            try:
+                kk = _geak_qnorm_kernel[(n,)](*args, H=H, D=D,
+                                              num_warps=_GEAK_QNORM_WARPS, num_stages=1)
+                if kk is not None and hasattr(kk, "run") and hasattr(kk, "__getitem__"):
+                    ck = kk
+            except Exception:
+                ck = None
+            _geak_qnorm_cache[key] = ck
+        ck = _geak_qnorm_cache[key]
+        if ck is not None:
+            ck[(n, 1, 1)](*args)
+            return o
+    _geak_qnorm_kernel[(n,)](*args, H=H, D=D,
+                             num_warps=_GEAK_QNORM_WARPS, num_stages=1)
+    return o
+
+
+def _geak_qnorm_ok(x, w) -> bool:
+    if not (_GEAK_QNORM and _GEAK_TRITON_OK):
+        return False
+    if x.ndim != 4 or not x.is_cuda or not x.is_contiguous():
+        return False
+    H, D = x.shape[2], x.shape[3]
+    if H & (H - 1) or D & (D - 1) or D < 16 or D > 256:
+        return False
+    return w is not None and w.dtype == x.dtype and w.is_contiguous() and w.shape == (D,)
+
