+# ROUND 3 -- GEAK_DIT_FUSELN: fold the residual-add / LayerNorm / AdaLN-affine
+# chain of the transformer-block loop into ONE triton kernel with TWO outputs.
+#
+# MEASURED SHAPE OF THE PROBLEM (round-2 tree, 4-step): region C is no longer a
+# fill problem -- only 21% of its dispatches underfill.  It is kernel-COUNT and
+# bandwidth bound.  Per block the loop issues, three times over,
+#     hs4 = addcmul(hs4, attn_out, gate)      # 784-CTA elementwise
+#     t   = LayerNorm(hs4)                    # 392-CTA vectorized_layer_norm
+#     nh  = addcmul(shift, t, one_plus_scale) # 784-CTA elementwise
+# = 9 separately dispatched full passes over the same [1,2,196,4096] bf16
+# activation, 162 elementwise launches (0.824 ms = 7.0% of ALL GPU busy) plus 90
+# layer-norm launches (0.639 ms).  They are WELL FILLED -- the lever is not grid
+# width, it is that the data is read and written three times instead of once.
+#
+# The fused kernel keeps one program per row (392 rows of 4096), loads hs4 and
+# the attention output once, and emits BOTH the new residual and the normalised+
+# modulated tensor the next stage consumes.  9 kernels/block -> 3, and the
+# chain's HBM traffic falls from 22.4 MB to 12.8 MB per group.
+#
+# The consumer of `nh` is the NEXT stage's attention/FF, and the producer of the
+# residual is the PREVIOUS stage -- so the fusion boundary does not line up with
+# the block boundary.  `_geak_forward_fused` therefore carries `nh` across the
+# block seam: one LayerNorm before the loop, one plain addcmul after the last
+# block, and 3 fused kernels per block in between.
+#
+# NUMERICS: every intermediate is rounded to the activation dtype at exactly the
+# points torch rounds it (residual after the addcmul, the norm result before the
+# affine, the affine result), and mean/variance accumulate in fp32 as
+# `vectorized_layer_norm_kernel<BFloat16, float>` does.  The only difference is
+# the reduction ORDER inside the 4096-element mean/var (block reduction vs
+# torch's Welford), i.e. sub-ULP on an fp32 accumulator feeding a bf16 output.
+# ---------------------------------------------------------------------------
+_GEAK_FUSELN = _geak_flag("GEAK_DIT_FUSELN")
+
+_GEAK_TRITON_OK = True
+try:
+    import triton as _geak_triton
+    import triton.language as _geak_tl
+except Exception:  # pragma: no cover -- triton always present on this stack
+    _GEAK_TRITON_OK = False
+
+if _GEAK_TRITON_OK:
+
+    @_geak_triton.jit
+    def _geak_addln_kernel(
+        X, A, G, SH, SC, R, O,
+        s_bt, HW, eps,
+        C: _geak_tl.constexpr, BLOCK: _geak_tl.constexpr,
+    ):
+        row = _geak_tl.program_id(0)
+        gt = row // HW
+        od = _geak_tl.arange(0, BLOCK)
+        m = od < C
+        x = _geak_tl.load(X + row * C + od, mask=m, other=0.0).to(_geak_tl.float32)
+        a = _geak_tl.load(A + row * C + od, mask=m, other=0.0).to(_geak_tl.float32)
+        g = _geak_tl.load(G + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        r = (x + a * g).to(R.dtype.element_ty)
+        _geak_tl.store(R + row * C + od, r, mask=m)
+        rf = _geak_tl.where(m, r.to(_geak_tl.float32), 0.0)
+        mu = _geak_tl.sum(rf, 0) / C
+        d = _geak_tl.where(m, rf - mu, 0.0)
+        var = _geak_tl.sum(d * d, 0) / C
+        y = (d * _geak_tl.rsqrt(var + eps)).to(O.dtype.element_ty).to(_geak_tl.float32)
+        sh = _geak_tl.load(SH + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        sc = _geak_tl.load(SC + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        _geak_tl.store(O + row * C + od, (sh + y * sc).to(O.dtype.element_ty), mask=m)
+
