+_GEAK_FUSELN_MODE = int(_geak_os.environ.get("GEAK_DIT_FUSELN_MODE", "1"))
+# MEASURED, and the reason a device-only win was a wall-clock LOSS on the first
+# attempt: region C is HOST-ISSUE bound (block-loop issue 5.0-5.5 ms against a
+# 5.66 ms region wall and 4.9 ms of device busy), and triton's *python* launcher
+# costs 13.2 us per call on this stack -- 24 us in-model -- against 4-5 us for a
+# torch elementwise op.  Fusing 3 torch ops (15-17 us of host) into one JIT-
+# launched triton kernel therefore ADDED ~7 us of host per stage and lost 0.76 ms
+# e2e even though it removed 1.0 ms of DEVICE time.  Launching the already-
+# compiled `CompiledKernel` directly skips JITFunction.run's signature hashing,
+# specialization lookup and arg binding: 13.2 us -> 5.9 us per launch, measured on
+# this box.  The JIT path stays as the fallback (and as the compile step).
+_GEAK_FUSELN_FAST = _geak_flag("GEAK_DIT_FUSELN_FAST")
+_geak_addln_cache = {}
