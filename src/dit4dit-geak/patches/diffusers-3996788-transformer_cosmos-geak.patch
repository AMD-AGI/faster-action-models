+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 ROUND 1 -- GEAK_DIT_CAFUSE: the cross-attention query RMS-norm is
+# folded INTO a triton flash-attention kernel, deleting a whole device node per
+# block from the 4.32 ms region that both scored cases share.
+#
+# WHY THIS AND NOT THE OTHER CANDIDATES (all measured on this box, device time
+# taken from HIP-graph replay so the triton python launcher is not in the
+# number; the isolated in-graph NODE FLOOR here is 1.79 us):
+#
+#   * The 18-block chain is STRICTLY SERIAL.  self-out-proj -> add+LN -> cross
+#     q-proj -> cross-out-proj are each other's inputs, so the three per-block
+#     [392,2048]x[2048,2048] GEMMs CANNOT be column-concatenated.  Measured
+#     F.linear 11.28 us vs mm(NN, pre-transposed B) 12.24 us -- and TunableOp's
+#     own sweep returns 11.47 us, i.e. the library has nothing better.  Same for
+#     QKV (20.05 / 21.86 / 20.47), FF-up (26.31 addmm_activation / 25.85 / 25.11)
+#     and FF-down (27.04 / 27.20 / 28.90).  The vendor GEMM lane is CLOSED and
+#     the PostGSU8 split-K reduction does not dissolve under any layout I could
+#     hand it, because M=392 is what starves the tiling, not the operand order.
+#   * aiter's fmha is NOT beatable here either: a hand-written triton flash
+#     attention swept over 72 (BLOCK_M, BLOCK_N, warps, stages) points lands at
+#     13.23 us against aiter's 13.73 us (self, S=392) and 13.74 vs 14.29 (cross,
+#     S_kv=512) -- inside noise.  The kernel is latency bound, not underfilled:
+#     the SAME call at batch 8 costs 22.4 us, i.e. 8x the work for 1.5x the time.
+#   * The fused add+LN+modulate kernel is already at 2.87 us against a 1.79 us
+#     floor for 6.4 MB of traffic; single-pass (E[x],E[x^2]) reduction, mask
+#     removal and multi-row programs were all measured and none beat it.
+#
+# What DOES pay is deleting a node.  The cross-attention query norm is a pure
+# per-row transform of the q tile that the attention kernel already loads, so
+# folding it in costs nothing and removes both the kernel AND its 3.2 MB
+# round-trip through HBM:
+#     _geak_qnorm_kernel + aiter::fmha   16.29 us   (2 nodes)
+#     _geak_cafa_kernel                  13.07 us   (1 node)
+# = -3.2 us and -1 node per block, x18 blocks, entirely inside the shared region.
+#
+# NUMERICS: the q transform is byte-for-byte `_geak_qnorm_kernel`'s (fp32
+# accumulation of sum(x*x) over D, one fp32 rsqrt, gain applied in fp32, one
+# rounding to bf16).  The attention itself is textbook online-softmax flash with
+# an fp32 accumulator and exp2; measured max|d| vs aiter on the real shape is
+# 3.9e-3 on unit-variance inputs, i.e. one bf16 ulp.
+#
+# Kill switch: GEAK_DIT_CAFUSE=0 restores `_geak_qnorm` + SDPA exactly.
+# ---------------------------------------------------------------------------
+_GEAK_CAFUSE = _geak_flag("GEAK_DIT_CAFUSE")
+_GEAK_CAFA_BM = int(_geak_os.environ.get("GEAK_DIT_CAFA_BM", "32"))
+_GEAK_CAFA_BN = int(_geak_os.environ.get("GEAK_DIT_CAFA_BN", "128"))
+_GEAK_CAFA_WARPS = int(_geak_os.environ.get("GEAK_DIT_CAFA_WARPS", "4"))
+_GEAK_CAFA_STAGES = int(_geak_os.environ.get("GEAK_DIT_CAFA_STAGES", "2"))
+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 ROUND 4 -- GEAK_DIT_CARCP: the same INSTRUCTION lane round 3 opened
+# on the two fp8 quantisers, applied to the largest triton kernel this file owns.
+#
+# `_geak_cafa_kernel` is 0.279 ms x 18 nodes in the profiler, more than either
+# quantiser, and two of its instruction costs are pure waste:
+#
+# (1) THE EPILOGUE DIVIDE.  `acc / l_i[:, None]` is a per-ELEMENT IEEE fp32
+#     division over a [BM, D] = [32, 128] accumulator -- 4096 divide expansions
+#     per program to apply 32 distinct row scales.  One reciprocal per ROW and a
+#     multiply is 32 divides + 4096 v_mul.  Exactly the round-3 lever.
+# (2) THE DEAD KV MASK.  The K/V loop is `for n0 in range(0, SKV, BN)` and the
+#     deployed shape has SKV = 512, BN = 128 -- FOUR whole iterations, never a
+#     partial one.  But `SKV` is a RUNTIME argument, so the compiler cannot
+#     prove it and emits, every iteration, a masked K load, a masked V load and
+#     a [BM, BN] = 4096-element `where(nm, qk, -inf)` select.  Hoisting
+#     `SKV % BN == 0` to a host-side constexpr deletes all of it.  (The M side
+#     is NOT even -- SQ = 392, BM = 32 -- so that mask stays.)
+#
+# MEASURED, real shapes [1,392,16,128] q / [1,16,512,128] kv, HIP-graph replay,
+# 25 timed replays of a 50-launch graph:
+#     shipped (divide + runtime KV mask)      13.458 us   1587 v_* , 80 mfma
+#     + reciprocal epilogue                   13.188 us   1430 v_*
+#     + EVEN_N (both, shipped)                12.553 us   1226 v_*   <- 1.072x
+#     + qk_scale folded into the exp2 FMA     12.565 us   1112 v_*   (tie, not shipped)
+#     + qk_scale folded into the rms gain     12.490 us   1106 v_*   (rejected:
+#        doubles err vs an fp64 reference, 1.29e-3 -> 2.66e-3, for 0.06 us)
+# The kernel stops being VALU-bound below ~1200 instructions, which is why the
+# last two rows buy nothing -- 1226 is the knee, and this lever reaches it.
+#
+# NUMERICS.  Error against an fp64 SDPA reference on the real shape is
+# 1.286e-03 for the shipped kernel and 1.286e-03 for this one -- IDENTICAL, to
+# every digit.  The two outputs differ from each other by 9.77e-04, which is
+# half a bf16 ulp at the output magnitude (bf16 ulp at 0.5 is 1.95e-03): the
+# reciprocal moves the rounding, it does not add error.  Removing a mask that
+# was never false cannot change a value at all.
+#
+# Kill switch: GEAK_DIT_CARCP=0 restores the divide AND the runtime KV mask,
+# both as compile-time constexpr, so the OFF arm is the round-3 kernel
+# instruction for instruction rather than a runtime branch.
+# ---------------------------------------------------------------------------
+_GEAK_CARCP = _geak_flag("GEAK_DIT_CARCP")
+_geak_cafa_cache = {}
+_geak_cafa_seen = [0]
+
+if _GEAK_TRITON_OK:
+
+    @_geak_triton.jit
+    def _geak_cafa_kernel(
+        XQ, W, K, V, O, SCL,
+        sqb, sqs, sqh, skb, sks, skh, svb, svs, svh, sob, sos, soh,
+        eps, qk_scale, SQ, SKV,
+        RCP: _geak_tl.constexpr, EVEN_N: _geak_tl.constexpr,
+        Q8: _geak_tl.constexpr, FMAX: _geak_tl.constexpr,
+        H: _geak_tl.constexpr, D: _geak_tl.constexpr,
+        BM: _geak_tl.constexpr, BN: _geak_tl.constexpr,
+    ):
+        pm = _geak_tl.program_id(0)
+        bh = _geak_tl.program_id(1)
+        b = bh // H
+        h = bh % H
+        d = _geak_tl.arange(0, D)
+        g = _geak_tl.load(W + d)[None, :].to(_geak_tl.float32)
+        offm = pm * BM + _geak_tl.arange(0, BM)
+        mm = offm < SQ
+        x = _geak_tl.load(XQ + b * sqb + h * sqh + offm[:, None] * sqs + d[None, :],
+                          mask=mm[:, None], other=0.0).to(_geak_tl.float32)
+        inv = _geak_tl.rsqrt(_geak_tl.sum(x * x, 1) / D + eps)[:, None]
+        q = (x * inv * g).to(XQ.dtype.element_ty)
+        m_i = _geak_tl.full([BM], -float('inf'), _geak_tl.float32)
+        l_i = _geak_tl.zeros([BM], _geak_tl.float32)
+        acc = _geak_tl.zeros([BM, D], _geak_tl.float32)
+        kb = K + b * skb + h * skh
+        vb = V + b * svb + h * svh
+        for n0 in range(0, SKV, BN):
+            offn = n0 + _geak_tl.arange(0, BN)
+            if EVEN_N:
+                # SKV % BN == 0 proved on the host: no K/V mask, no -inf select
+                kk = _geak_tl.load(kb + offn[:, None] * sks + d[None, :])
+                qk = _geak_tl.dot(q, _geak_tl.trans(kk)) * qk_scale
+            else:
+                nm = offn < SKV
+                kk = _geak_tl.load(kb + offn[:, None] * sks + d[None, :],
+                                   mask=nm[:, None], other=0.0)
+                qk = _geak_tl.dot(q, _geak_tl.trans(kk)) * qk_scale
+                qk = _geak_tl.where(nm[None, :], qk, -float('inf'))
+            mn = _geak_tl.maximum(m_i, _geak_tl.max(qk, 1))
+            al = _geak_tl.math.exp2(m_i - mn)
+            p = _geak_tl.math.exp2(qk - mn[:, None])
+            l_i = l_i * al + _geak_tl.sum(p, 1)
+            acc = acc * al[:, None]
+            if EVEN_N:
+                v = _geak_tl.load(vb + offn[:, None] * svs + d[None, :])
+            else:
+                v = _geak_tl.load(vb + offn[:, None] * svs + d[None, :],
+                                  mask=(offn < SKV)[:, None], other=0.0)
+            acc = _geak_tl.dot(p.to(v.dtype), v, acc)
+            m_i = mn
+        if Q8:
+            # GEAK_DIT_OPROJ8: STATIC per-tensor activation scale, resolved once
+            # per prompt on the host and read from a 1-element device scalar, so
+            # the epilogue emits OCP e4m3 with NO reduction and NO extra node.
+            # `rs` is folded into the same reciprocal the RCP lever already
+            # computes, so the fp8 arm costs the SAME [BM,D] multiply the bf16
+            # arm costs -- the only added instructions are the two clamps.
+            rs = _geak_tl.load(SCL)
+            if RCP:
+                acc = acc * (rs / l_i)[:, None]
+            else:
+                acc = (acc / l_i[:, None]) * rs
+            acc = _geak_tl.minimum(_geak_tl.maximum(acc, -FMAX), FMAX)
+        elif RCP:
+            # one reciprocal per ROW instead of one fp32 divide per ELEMENT
+            acc = acc * (1.0 / l_i)[:, None]
+        else:
+            acc = acc / l_i[:, None]
+        _geak_tl.store(O + b * sob + h * soh + offm[:, None] * sos + d[None, :],
+                       acc.to(O.dtype.element_ty), mask=mm[:, None])
+
+
+def _geak_cafa_ok(q4, w, k4, v4) -> bool:
+    """q4: [B, S, H, D] contiguous (raw to_q output).  k4/v4: [B, H, Skv, D]
+    views whose last dim is contiguous."""
+    if not (_GEAK_CAFUSE and _GEAK_TRITON_OK):
+        return False
+    if q4.ndim != 4 or not q4.is_cuda or not q4.is_contiguous():
+        return False
+    B, S, H, D = q4.shape
+    if D & (D - 1) or D < 16 or D > 256 or S <= 0:
+        return False
+    if w is None or w.dtype != q4.dtype or not w.is_contiguous() or w.shape != (D,):
+        return False
+    for t in (k4, v4):
+        if t.ndim != 4 or t.dtype != q4.dtype or t.stride(3) != 1:
+            return False
+        if t.shape[0] != B or t.shape[1] != H or t.shape[3] != D:
+            return False
+    if k4.shape[2] != v4.shape[2]:
+        return False
+    return True
+
+
+def _geak_cross_fa(q4, w, eps, k4, v4, q8=None):
+    """Fused cross-attention: RMS-norm(q4) -> flash attention against the cached
+    k4/v4.  Returns a contiguous [B, S, H*D] tensor, or None if ineligible.
+
+    `q8`, when given, is `(rcp, scale_a)` from `_geak_oproj8_scale`: the epilogue
+    then emits OCP e4m3 pre-divided by the static scale instead of bf16."""
+    B, S, H, D = q4.shape
+    SKV = k4.shape[2]
+    if q8 is None:
+        o = torch.empty((B, S, H, D), device=q4.device, dtype=q4.dtype)
+        scl = _geak_scl_dummy(q4.device)
+    else:
+        o = torch.empty((B, S, H, D), device=q4.device, dtype=_GEAK_F8)
+        scl = q8[0]
+    scale = float(D ** -0.5) * 1.4426950408889634
+    args = (q4, w, k4, v4, o, scl,
+            q4.stride(0), q4.stride(1), q4.stride(2),
+            k4.stride(0), k4.stride(2), k4.stride(1),
+            v4.stride(0), v4.stride(2), v4.stride(1),
+            o.stride(0), o.stride(1), o.stride(2),
+            float(eps), scale, S, SKV)
+    BM = _GEAK_CAFA_BM
+    grid = ((S + BM - 1) // BM, B * H, 1)
+    # `SKV % BN == 0` is a HOST fact the kernel cannot prove -- hoist it.
+    even_n = bool(_GEAK_CARCP) and (SKV % _GEAK_CAFA_BN == 0)
+    q8f = q8 is not None
+    key = (S, SKV, H, D, B, q4.dtype, _GEAK_CARCP, even_n, q8f)
+    if _GEAK_FUSELN_FAST:
+        if key not in _geak_cafa_cache:
+            ck = None
+            try:
+                kk = _geak_cafa_kernel[grid](
+                    *args, RCP=_GEAK_CARCP, EVEN_N=even_n,
+                    Q8=q8f, FMAX=_GEAK_F8MAX,
+                    H=H, D=D, BM=BM, BN=_GEAK_CAFA_BN,
+                    num_warps=_GEAK_CAFA_WARPS, num_stages=_GEAK_CAFA_STAGES)
+                if kk is not None and hasattr(kk, "run") and hasattr(kk, "__getitem__"):
+                    ck = kk
+            except Exception:
+                ck = None
+            _geak_cafa_cache[key] = ck
+        ck = _geak_cafa_cache[key]
+        if ck is not None:
+            ck[grid](*args)
+            return o.view(B, S, H * D)
+    _geak_cafa_kernel[grid](
+        *args, RCP=_GEAK_CARCP, EVEN_N=even_n,
+        Q8=q8f, FMAX=_GEAK_F8MAX,
+        H=H, D=D, BM=BM, BN=_GEAK_CAFA_BN,
+        num_warps=_GEAK_CAFA_WARPS, num_stages=_GEAK_CAFA_STAGES)
+    return o.view(B, S, H * D)
+
+
+# ---------------------------------------------------------------------------
+# CAMPAIGN 3 ROUND 1 -- GEAK_DIT_OPROJ8: ATTENTION-EPILOGUE OWNERSHIP.
+# The cross-attention out-projection ([392,2048]x[2048,2048]) runs in fp8 e4m3
+# with NO extra dispatch and NO runtime reduction.
+#
+# WHY THIS IS NOT THE CLOSURE CAMPAIGN 2 RECORDED.  Round 2 left the two
+# out-projections in bf16 with the note "their activation is an attention
+# output, not an add+LN output, so it would need its OWN quant node: 2.60 us of
+# rowwise quant against a 2.33 us GEMM saving".  Every one of the three
+# closures on record was about the QUANTISER, never about the GEMM:
+#   (a) ROWWISE needs an amax over the whole 2048-wide row, but the attention
+#       kernel is parallel over HEADS -- one program owns only D=128 of that row.
+#   (b) A STANDALONE quant node costs more than the GEMM saves.
+#   (c) 1x128 block granularity is refused by torch._scaled_mm and MXFP8 1x32
+#       measured slower than bf16 on every Cosmos shape.
+# A STATIC PER-TENSOR activation scale defeats all three at once: each program
+# quantises the tile it already holds in registers, with a scalar it reads from
+# a 1-element device tensor.  No reduction, no extra node, no per-head conflict.
+#
+# WHERE THE SCALE COMES FROM -- a BOUND, not a calibration.  The attention
+# output is a CONVEX COMBINATION of the V rows (softmax weights are >=0 and sum
+# to 1), so for every row m and channel c
+#       |out[m, c]| = |sum_j p[m, j] V[j, c]|  <=  max_j |V[j, c]|  <=  amax(V).
+# On the cross-attention path V is the CACHED, prompt-derived value tensor
+# (GEAK_DIT_TXTCACHE), so `amax(V)` is an instruction-invariant constant that is
+# computed ONCE per prompt, on an eager call, outside any graph capture, and
+# pinned on the module for the captured graph's lifetime.  It is therefore a
+# baked constant on the timed path -- and, unlike a calibrated constant, it is a
+# PROVABLE upper bound: this quantiser can never clip, on any frame, ever.
+#
+# WHY A LOOSE BOUND IS FREE IN e4m3 (and would NOT be in int8).  e4m3 is a
+# FLOATING-point format: 4 exponent bits, 3 mantissa bits, so its ~3.1% relative
+# grain is the same for every value in [2^-6, 448] of the scaled domain -- a
+# 2^14.8 dynamic range.  A scale that is R times looser than the true amax only
+# moves the subnormal knee from max/28672 to R*max/28672; it does not coarsen a
+# single value that matters.  The measured looseness on the deployed shapes is
+# recorded by GEAK_DIT_OPROJ8_ECHO=1 (amax(V) vs the realised |out| amax).
+#
+# COST ACCOUNTING (this box, HIP-graph replay, M=392 K=2048 N=2048, medians):
+#     bf16 F.linear                        10.12 us
+#     _scaled_mm rowwise x rowwise          7.69 us
+#     _scaled_mm const scale_a x rowwise    7.64 us   <- shipped
+#     _scaled_mm per-tensor x per-tensor    7.39 us   (needs a scalar WEIGHT
+#                                                      scale; not taken)
+# = -2.48 us x 18 blocks, plus the cafa epilogue storing HALF the bytes
+# (0.8 MB instead of 1.6 MB per block).  Node count is FLAT: 36 -> 36.
+# `scale_a` is a [M,1] fp32 constant built with the scale, so the GEMM takes the
+# rowwise (PTPC) path the rest of this file already uses and the WEIGHT keeps its
+# per-output-channel scale -- the accurate granularity is preserved on the side
+# that can afford it.
+#
+# Kill switch: GEAK_DIT_OPROJ8=0 restores the bf16 epilogue and F.linear exactly
+# (Q8 is a compile-time constexpr, so the OFF arm is the round-4 kernel
+# instruction for instruction, not a runtime branch).
+# GEAK_DIT_OPROJ8_ECHO=1 prints liveness + the realised quantisation margin.
+# ---------------------------------------------------------------------------
+_GEAK_OPROJ8 = _geak_flag("GEAK_DIT_OPROJ8")
+_GEAK_OPROJ8_ECHO = _geak_flag("GEAK_DIT_OPROJ8_ECHO", "0")
+# Extra multiplicative headroom on the (already rigorous) bound.  1.0 is exact;
+# raising it only wastes e4m3 exponent range, lowering it below 1.0 would make
+# the bound non-rigorous and is refused.
+_GEAK_OPROJ8_HEAD = max(1.0, float(_geak_os.environ.get("GEAK_DIT_OPROJ8_HEAD", "1.0")))
+_geak_oproj8_seen = [0]
+_geak_scl_dummies = {}
+
+
+def _geak_scl_dummy(device):
+    """A 1-element fp32 device tensor for the OFF arm's (never-executed) SCL
+    pointer argument.  Allocated once per device, never read."""
+    d = _geak_scl_dummies.get(device)
+    if d is None:
+        d = torch.zeros(1, device=device, dtype=torch.float32)
+        _geak_scl_dummies[device] = d
+    return d
+
+
+def _geak_oproj8_plan(attn, v4, n):
+    """(rcp[1] fp32, scale_a[n,1] fp32, (mat2, wscale)) for this module's cross
+    out-projection, or None.  Cached on the module and keyed on the IDENTITY of
+    the cached V tensor -- V is a pure function of the prompt, so the key is
+    instruction-invariant (never frame-derived) and the entry holds a strong
+    reference so it can neither be recycled nor freed under a captured graph."""
+    if not (_GEAK_OPROJ8 and _GEAK_FASTFN and _GEAK_F8 is not None):
+        return None
+    c = getattr(attn, "_geak_o8", None)
+    if c is not None and c[0] is v4 and c[1] == n:
+        return c[2]
+    try:
+        if torch.cuda.is_current_stream_capturing():
+            return None            # never build a scale inside a capture
+    except Exception:
+        pass
+    plan = None
+    try:
+        p = _geak_out_params(attn)
+        if p is not False and p[1] is None:
+            wp = _geak_fp8_w(attn, "_geak_f8o", p[0])
+            if wp:
+                amax = v4.detach().float().abs().amax().clamp(min=1e-12)
+                amax = amax * _GEAK_OPROJ8_HEAD
+                sa = (amax / _GEAK_F8MAX).reshape(1, 1).expand(n, 1).contiguous()
+                rcp = (_GEAK_F8MAX / amax).reshape(1).contiguous()
+                plan = (rcp, sa, wp)
+    except Exception:
+        plan = None
+    attn._geak_o8 = (v4, n, plan)
+    if plan is not None and _geak_oproj8_seen[0] == 0:
+        _geak_oproj8_seen[0] = 1
+        if _GEAK_VERIFY or _GEAK_OPROJ8_ECHO:
+            print("[geak] OPROJ8 LIVE: v=%s n=%d amax(V)=%.4f scale_a=%.6g"
+                  % (tuple(v4.shape), n, float(v4.detach().float().abs().amax()),
+                     float(plan[1][0, 0])), flush=True)
+    return plan
+
+
+def _geak_cross_attn_fused(attn, q4, k4, v4):
+    """Full cross-attention tail on the fused path, or None when ineligible."""
+    nq = attn.norm_q
+    if not (_GEAK_NORMPRE and getattr(nq, "bias", None) is None
+            and getattr(nq, "elementwise_affine", False) and hasattr(nq, "dim")):
+        return None
+    w = getattr(nq, "weight", None)
+    dim = tuple(nq.dim)
+    if len(dim) != 1 or dim[0] != q4.shape[3]:
+        return None
+    if not _geak_cafa_ok(q4, w, k4, v4):
+        return None
+    q8 = _geak_oproj8_plan(attn, v4, q4.shape[0] * q4.shape[1])
+    h = _geak_cross_fa(q4, w, float(nq.eps), k4, v4, q8)
+    if h is None:
+        return None
+    if q8 is not None:
+        n = q4.shape[0] * q4.shape[1]
+        o = _geak_f8mm(h.view(n, -1), q8[1], q8[2])
+        return o.view(q4.shape[0], q4.shape[1], -1)
+    if _geak_cafa_seen[0] == 0:
+        _geak_cafa_seen[0] = 1
+        if _GEAK_VERIFY or _geak_flag("GEAK_DIT_CAFUSE_ECHO", "0"):
+            print("[geak] CAFUSE LIVE: q=%s kv=%s grid=%d x %d" %
+                  (tuple(q4.shape), tuple(k4.shape),
+                   (q4.shape[1] + _GEAK_CAFA_BM - 1) // _GEAK_CAFA_BM,
+                   q4.shape[0] * q4.shape[2]), flush=True)
+    if _GEAK_FASTFN:
+        p = _geak_out_params(attn)
+        if p is not False:
+            return F.linear(h, p[0], p[1])
+    return attn.to_out[1](attn.to_out[0](h))
+
+# ---------------------------------------------------------------------------
+# ROUND 5 -- GEAK_DIT_FFGELU: the FeedForward up-projection carries its own GELU
+# in the GEMM epilogue (hipBLASLt GELU epilogue via aten::_addmm_activation)
+# instead of dispatching GeluCUDAKernelImpl over the [392, 8192] intermediate.
+#
+# MEASURED (this box, real shapes, bf16):
+#   F.gelu(F.linear(x, w1))          27.22 us (GEMM) + 6.05 us (Gelu) = 33.27 us
+#   torch._addmm_activation(...gelu) 26.77 us total, ONE dispatch
+# = -6.5 us of device AND -1 node (-1.78 us of in-graph floor) x 18 blocks
+# = ~-0.12 ms/iter.  The epilogue is applied in the fp32 accumulator before the
+# store, so the [392, 8192] intermediate is never re-read from HBM.
+#
+# NUMERICS: hipBLASLt's GELU epilogue is the tanh approximation, torch's default
+# is erf.  Measured on the real shape the two differ by 0.03125 = exactly ONE
+# bf16 ulp at the magnitude where the gap peaks (|x|~2), i.e. the approximation
+# error is BELOW the storage precision of the tensor it lands in.
+# ---------------------------------------------------------------------------
+_GEAK_FFGELU = _geak_flag("GEAK_DIT_FFGELU")
+
+# ---------------------------------------------------------------------------
+# ROUND 5 -- GEAK_DIT_TUNABLE: let hipBLASLt pick the GEMM kernel by MEASUREMENT
+# instead of by heuristic, for the block loop's four distinct shapes.
+#
+# WHY (the arithmetic that made this the biggest lever left in region C).  The
+# block GEMMs are not FLOP bound and they are not HBM bound -- they are bound by
+# the number of times the WEIGHT matrix is re-read, which is exactly the number
+# of M tiles.  M is 392 (2 frames x 196 tokens), so a macro-tile of MT_M=64 reads
+# every weight SEVEN times and MT_M=128 reads it four times: per block the six
+# GEMMs hold 117 MB of weights, so the M-tile choice is worth hundreds of MB of
+# L2/HBM traffic per block.  hipBLASLt's heuristic picks MT64x224 for the FF up
+# projection and MT64x64 for the three 2048x2048 projections -- both MT_M=64.
+#
+# MEASURED, this box, real shapes, bf16 (torch.profiler, 40 reps, hot):
+#     [392,2048]x[2048,2048]   heuristic MT64x64x256   12.15 us
+#                              tuned     MT64x64x128    9.41 us   (-23%)
+#     [392,2048]x[2048,8192]   heuristic MT64x224x128  27.2  us
+#     + fused GELU epilogue    tuned     MT128x128x..  21.05 us   (-23%)
+#     [392,2048]x[2048,6144]   16.68 -> 16.09 us
+#     [392,8192]x[8192,2048]   25.24 -> 25.11 us  (split-K reduction dominates)
+# 54 + 18 launches of the first two per forward = ~-0.37 ms of pure GEMM time.
+#
+# Tuning runs ONCE per shape on first sight, inside the harness's 25 untimed
+# warmups, and is skipped by torch while a stream is capturing (so r3_d0's
+# backbone graph is unaffected).  Results are cached in-process and mirrored to
+# a /tmp CSV so a re-launched process does not re-tune.
+# ---------------------------------------------------------------------------
+# SHIPPED OFF -- MEASURED, and the measurement is the point (see the note above
+# the switch).  Region-C-scoped tuning is worth ~0 because hipBLASLt's heuristic
+# is already at the cold optimum for these four shapes: TunableOp's own COLD
+# (rotating-buffer) sweep found 12.18 us for [392,2048]x[2048,2048] against a
+# 12.15 us heuristic default, i.e. nothing better exists in the library.  The
+# 23% "win" an isolated sweep shows for that shape is the round-4 hot-L2 trap --
+# one weight matrix reused across launches is permanently L2-resident and the
+# ranking inverts.  Tuning the WHOLE process (GEAK_DIT_TUNABLE_SCOPE=all) IS
+# worth 5.800 -> 5.575 ms of geomean, but every microsecond of that comes from
+# the Qwen VLM GEMMs (tn_3584_512_3584 / tn_18944_512_3584), i.e. another lane's
+# region, and it costs ~9 MINUTES of tuning per process (347 s even capped at
+# 1 ms x 5 iters per solution, which also degrades the pick to 5.723).  Recorded
+# for the TechLead; not shipped from this lane.
+_GEAK_TUNABLE = _geak_flag("GEAK_DIT_TUNABLE", "0")
+
+
+# Tuning is expensive (one measured sweep per SHAPE) and it must not run while a
+# stream is capturing, so it is switched on ONLY around the region-C block loop
+# and ONLY for the first few calls -- which land inside the harness's untimed
+# warmups.  Lookup stays on globally (a hash probe per GEMM, no measurement); an
+# untuned shape simply falls through to hipBLASLt's own heuristic, so nothing
+# outside this lane changes behaviour.
+_GEAK_TUNABLE_CALLS = int(_geak_os.environ.get("GEAK_DIT_TUNABLE_CALLS", "4"))
+_GEAK_TUNABLE_SCOPE = _geak_os.environ.get("GEAK_DIT_TUNABLE_SCOPE", "block")
+_geak_tun_budget = [_GEAK_TUNABLE_CALLS if _GEAK_TUNABLE else 0]
+
+
+def _geak_enable_tunable():
+    if not _GEAK_TUNABLE:
+        return
+    try:
+        t = torch.cuda.tunable
+        if t.is_enabled():
+            return
+        t.set_filename(_geak_os.environ.get(
+            "GEAK_DIT_TUNABLE_FILE",
+            "/tmp/geak_dit_c_tunable_%d.csv"), True)
+        t.set_max_tuning_duration(
+            int(_geak_os.environ.get("GEAK_DIT_TUNABLE_MS", "30")))
+        try:
+            t.set_max_tuning_iterations(
+                int(_geak_os.environ.get("GEAK_DIT_TUNABLE_ITERS", "100")))
+        except Exception:
+            pass
+        t.enable(True)
+        t.tuning_enable(_GEAK_TUNABLE_SCOPE == "all")
+    except Exception:
+        pass
+
+
+_geak_enable_tunable()
+
+
+def _geak_tun_begin() -> bool:
+    if _geak_tun_budget[0] <= 0 or _GEAK_TUNABLE_SCOPE != "block":
+        return False
+    try:
+        if torch.cuda.is_current_stream_capturing():
+            return False
+        torch.cuda.tunable.tuning_enable(True)
+        return True
+    except Exception:
+        return False
+
+
+def _geak_tun_end():
+    try:
+        torch.cuda.tunable.tuning_enable(False)
+    except Exception:
+        pass
+    _geak_tun_budget[0] -= 1
+
+
+
+if _GEAK_TRITON_OK:
+
+    @_geak_triton.jit
+    def _geak_qkrope_kernel(
+        T, W, COS, SIN, Q, K, eps,
+        H: _geak_tl.constexpr, D: _geak_tl.constexpr, HD: _geak_tl.constexpr,
+    ):
+        row = _geak_tl.program_id(0)
+        h = _geak_tl.arange(0, H)
+        d = _geak_tl.arange(0, D)
+        off = h[:, None] * D + d[None, :]
+        dr = (d + D // 2) % D
+        offr = h[:, None] * D + dr[None, :]
+        neg = d < (D // 2)
+
+        cs = _geak_tl.load(COS + row * D + d)[None, :]
+        sn = _geak_tl.load(SIN + row * D + d)[None, :]
+        base = row * 3 * HD
+
+        for j in _geak_tl.static_range(2):
+            x = _geak_tl.load(T + base + j * HD + off).to(_geak_tl.float32)
+            xr = _geak_tl.load(T + base + j * HD + offr).to(_geak_tl.float32)
+            inv = _geak_tl.rsqrt(_geak_tl.sum(x * x, 1) / D + eps)[:, None]
+            g = _geak_tl.load(W + j * D + d)[None, :].to(_geak_tl.float32)
+            gr = _geak_tl.load(W + j * D + dr)[None, :].to(_geak_tl.float32)
+            a = ((x * inv).to(Q.dtype.element_ty).to(_geak_tl.float32) * g).to(Q.dtype.element_ty)
+            b = ((xr * inv).to(Q.dtype.element_ty).to(_geak_tl.float32) * gr).to(Q.dtype.element_ty)
+            bf = _geak_tl.where(neg[None, :], -b.to(_geak_tl.float32), b.to(_geak_tl.float32))
+            o = (a.to(_geak_tl.float32) * cs + bf * sn).to(Q.dtype.element_ty)
+            if j == 0:
+                _geak_tl.store(Q + row * HD + off, o)
+            else:
+                _geak_tl.store(K + row * HD + off, o)
+
+
+def _geak_qkrope(t5, wqk, cos, sin, eps, warps=4):
+    """t5: [B, S, 3, H, D] contiguous.  wqk: [2,1,1,1,D].  cos/sin: [S, D] fp32.
+    Returns contiguous q, k of shape [B, S, H, D]."""
+    B, S, _, H, D = t5.shape
+    n = B * S
+    q = torch.empty((B, S, H, D), device=t5.device, dtype=t5.dtype)
+    k = torch.empty((B, S, H, D), device=t5.device, dtype=t5.dtype)
+    args = (t5, wqk, cos, sin, q, k, float(eps))
+    key = (n, H, D, t5.dtype)
+    if _GEAK_FUSELN_FAST:
+        if key not in _geak_qkrope_cache:
+            ck = None
+            try:
+                kk = _geak_qkrope_kernel[(n,)](*args, H=H, D=D, HD=H * D,
+                                              num_warps=warps,
+                                              num_stages=_GEAK_QKROPE_STAGES)
+                if kk is not None and hasattr(kk, "run") and hasattr(kk, "__getitem__"):
+                    ck = kk
+            except Exception:
+                ck = None
+            _geak_qkrope_cache[key] = ck
+        ck = _geak_qkrope_cache[key]
+        if ck is not None:
+            ck[(n, 1, 1)](*args)
+            return q, k
+    _geak_qkrope_kernel[(n,)](*args, H=H, D=D, HD=H * D,
+                              num_warps=warps, num_stages=_GEAK_QKROPE_STAGES)
+    return q, k
+
+
+
+def _geak_addln_compiled(key, args, grid, nw):
+    """Return a direct launcher for the already-compiled kernel, or None."""
+    if key in _geak_addln_cache:
+        return _geak_addln_cache[key]
+    ck = None
+    try:
+        k = _geak_addln_kernel[grid](*args, C=key[1], BLOCK=key[1],
+                                     num_warps=nw, num_stages=_GEAK_FUSELN_STAGES)
+        if k is not None and hasattr(k, "run") and hasattr(k, "__getitem__"):
+            ck = k
+    except Exception:
+        ck = None
+    _geak_addln_cache[key] = ck
+    return ck
+
+
+def _geak_fuseln_ok(x4, gate, shift, scale) -> bool:
+    if not (_GEAK_FUSELN and _GEAK_TRITON_OK):
+        return False
+    if not x4.is_cuda or not x4.is_contiguous() or x4.ndim != 4:
+        return False
+    B, T, S, C = x4.shape
+    if C & (C - 1):                       # kernel assumes BLOCK == C, a power of two
+        return False
+    for t in (gate, shift, scale):
+        if t.shape != (B, T, 1, C) or t.stride(-1) != 1 or t.dtype != x4.dtype:
+            return False
+        if B > 1 and t.stride(0) != T * t.stride(1):
+            return False
+    return True
+
+
+def _geak_add_ln_mod(x4, a4, gate, shift, scale, eps):
+    """(x4 + a4*gate) -> residual, then LayerNorm(residual)*scale + shift -> nh.
+
+    Exactly the three ops it replaces:
+        r  = torch.addcmul(x4, a4, gate)
+        nh = torch.addcmul(shift, norm(r), scale)
+    """
+    B, T, S, C = x4.shape
+    if _GEAK_FUSELN_MODE == 0:            # bisect: same control flow, stock kernels
+        r = torch.addcmul(x4, a4, gate)
+        return r, torch.addcmul(shift, F.layer_norm(r, (C,), None, None, eps), scale)
+    if not a4.is_contiguous():
+        a4 = a4.contiguous()
+    n = B * T * S
+    x = x4.reshape(n, C)
+    a = a4.reshape(n, C)
+    r = torch.empty_like(x)
+    o = torch.empty_like(x)
+    sbt = gate.stride(1)
+    args = (x, a, gate, shift, scale, r, o, sbt, S, float(eps))
+    if _GEAK_FUSELN_FAST:
+        ck = _geak_addln_compiled((n, C, sbt, S, x.dtype), args, (n,),
+                                  _GEAK_FUSELN_WARPS)
+        if ck is not None:
+            ck[(n, 1, 1)](*args)
+            return r.view(B, T, S, C), o.view(B, T, S, C)
+    _geak_addln_kernel[(n,)](
+        *args, C=C, BLOCK=C, num_warps=_GEAK_FUSELN_WARPS,
+        num_stages=_GEAK_FUSELN_STAGES,
+    )
+    return r.view(B, T, S, C), o.view(B, T, S, C)
+
+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 ROUND 2 -- GEAK_DIT_FP8: the Cosmos block GEMMs in OCP fp8 (e4m3),
+# with the ACTIVATION QUANTISATION FOLDED INTO the fused add+LN kernel's row
+# reduction so it costs a narrower store instead of a whole extra pass.
+#
+# WHY.  Post-CAFUSE a block is at its structural minimum (13 device nodes for
+# 6 GEMMs + 2 attentions + 3 add+LN stages).  Its GEMMs are ~1.7-1.9 ms = 40% of
+# the dit_1step wall and they sit at the bf16 vendor optimum.  Precision is the
+# only axis left.  MEASURED on this box (HIP-graph replay, M=392):
+#
+#     shape                bf16    fp8 rowwise   fp8 per-tensor
+#     qkv    K2048 N6144   15.66   13.54 (1.16)  10.10 (1.55)
+#     proj   K2048 N2048    9.73    7.40 (1.32)   7.14 (1.36)
+#     ffup   K2048 N8192   23.51   13.29 (1.77)  12.12 (1.94)
+#     ffdown K8192 N2048   24.46   16.12 (1.52)  23.46 (1.04)   <- pt is useless
+#
+# ROWWISE (per-token activation, per-output-channel weight) is the shipped
+# recipe: it is the only granularity that pays on ffdown, it is the accurate one
+# (PTPC), and -- decisively -- it is the only one a per-row kernel can produce
+# for free.  A per-tensor activation scale needs a cross-program reduction, i.e.
+# a whole extra node, which is exactly the cost this direction has to avoid.
+#
+# WHAT IS AND IS NOT CONVERTED, and why (all costs measured, node floor 1.79 us):
+#   * QKV, cross q-proj, FF-up, FF-down  -> fp8.  Their activation is `nh`, the
+#     output of the fused add+LN stage, which already loads the whole 2048-wide
+#     row into registers and already runs two row reductions.  Adding the amax
+#     and storing fp8 instead of bf16 makes the stage store LESS (0.8 MB instead
+#     of 1.6 MB), so the quantisation is free-to-negative, not an afterthought.
+#   * The FF intermediate [392, 8192] is quantised by one fused GELU+quant
+#     kernel that replaces the hipBLASLt GELU epilogue we lose by leaving addmm.
+#   * self out-proj and cross out-proj STAY bf16.  Their activation is an
+#     attention output, not an add+LN output, so it would need its OWN quant
+#     node: measured 2.60 us for a [392, 2048] rowwise quant against a 2.33 us
+#     GEMM saving.  Converting them is a NET LOSS and they are left alone.
+#   * Block 0's QKV stays bf16: its `nh` comes from the loop preamble's addcmul,
+#     not from a fused stage, so the same 2.60-vs-2.12 arithmetic applies.
+#
+# NUMERICS.  fp8 e4m3 is ~3.7e-2 relative against bf16's 1.4e-3.  The value the
+# quantiser sees is rounded to bf16 first, i.e. it is EXACTLY the tensor the
+# bf16 GEMM would have consumed; only the GEMM's operand precision changes, the
+# accumulator stays fp32 and the output stays bf16.  The residual stream itself
+# is never quantised -- `r` stays bf16 through all 18 blocks -- so the error
+# enters as a per-block perturbation of the branch output and is damped by the
+# gate, rather than compounding along the skip path.  This is gated on the
+# closed-loop LIBERO rollout, not on a numeric tolerance (see report).
+#
+# gfx950 is OCP fp8 (e4m3fn / e5m2), NOT gfx942's FNUZ flavours; using the FNUZ
+# dtype here makes the compiler emulate the convert in software.
+#
+# Kill switch: GEAK_DIT_FP8=0 restores the bf16 path exactly (a different
+# add+LN kernel is not even compiled).  GEAK_DIT_FP8_OPS selects the shapes
+# ("qkv,cq,ff"), GEAK_DIT_FP8_L0/L1 the block range.
+# ---------------------------------------------------------------------------
+_GEAK_FP8 = _geak_flag("GEAK_DIT_FP8")
+_GEAK_FP8_OPS = set(x for x in _geak_os.environ.get(
+    "GEAK_DIT_FP8_OPS", "qkv,cq,ff").replace(" ", "").split(",") if x)
+_GEAK_FP8_L0 = int(_geak_os.environ.get("GEAK_DIT_FP8_L0", "0"))
+_GEAK_FP8_L1 = int(_geak_os.environ.get("GEAK_DIT_FP8_L1", "999"))
+_GEAK_FP8_ECHO = _geak_flag("GEAK_DIT_FP8_ECHO", "0")
+_GEAK_FP8_GQW = int(_geak_os.environ.get("GEAK_DIT_FP8_GQW", "8"))
+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 ROUND 3 -- GEAK_DIT_GELUPOLY / GEAK_DIT_QRCP: the two fp8 quantiser
+# kernels this file owns were spending most of their time on SCALAR MATH, not on
+# memory, and both costs are invisible against an fp8 output.
+#
+# MEASURED on this box (HIP-graph replay, real shapes, so the triton python
+# launcher is not in the number; in-graph node floor 2.06 us):
+#
+#   _geak_geluq_kernel  [392, 8192]        (9.6 MB moved)
+#     exact-erf + per-element divide            7.40 us   <- round-2 shipped
+#     exact-erf, reciprocal multiply            ~6.3 us
+#     poly GELU + per-element divide            5.02 us
+#     poly GELU + reciprocal multiply           3.86 us   <- shipped
+#     quantise only, no activation at all       4.16 us   (the memory floor)
+#   _geak_addln_q8_kernel [392, 2048]      (5.6 MB moved)
+#     per-element divide                        3.90 us   <- round-2 shipped
+#     reciprocal multiply                       3.62 us   <- shipped
+#
+# (1) THE DIVIDE.  `o / s` with a per-ROW scalar `s` emits a full IEEE fp32
+#     division per ELEMENT -- 8192 of them per program in geluq.  Hoisting one
+#     reciprocal (`fmax / am`) out of the row and multiplying is 8192 v_mul
+#     against 8192 divide expansions: -1.16 us in geluq, -0.28 us in addln_q8.
+#     The stored scale is still `am / fmax`, so the GEMM's dequantisation is
+#     unchanged; only the quantisation rounds through a reciprocal, i.e. ~1e-7
+#     relative on a value that is about to be rounded to THREE mantissa bits.
+#
+# (2) THE ERF.  `tl.math.erf` is an ocml call.  Its result is immediately
+#     rounded to bf16 and then quantised to OCP e4m3, whose relative grain is
+#     ~6e-2 -- five orders coarser than erf's exactness.  A degree-13 odd
+#     minimax polynomial for Phi(x) = 0.5(1 + erf(x/sqrt2)) on a clamped
+#     [-4, 4], evaluated as 0.5 + t*P(t^2) in seven FMAs, is -1.16 us more.
+#     max|Phi err| 4.4e-4 => max|gelu err| 1.8e-3 in range; above +4 the form
+#     degrades to 0.99997*x (a 3.2e-5 RELATIVE error, self-scaling), and below
+#     -4 it is forced to exactly 0 (true value there is |gelu| < 1.3e-4).
+#     MEASURED end to end on the real [392, 8192] distribution, both against the
+#     exact bf16 GELU: the shipped erf path's own fp8 error is 2.6458e-2 and the
+#     polynomial path's is 2.6464e-2 -- the approximation contributes 0.02% of an
+#     error the kernel was already committing.
+#
+# Kill switches, independent, both default ON:
+#   GEAK_DIT_GELUPOLY=0 -> exact `tl.math.erf` back in _geak_geluq_kernel
+#   GEAK_DIT_QRCP=0     -> per-element divide back in BOTH quantiser kernels
+# Both are compile-time `tl.constexpr` on the kernels, so an OFF arm is the
+# round-2 kernel instruction for instruction, not a runtime branch.
+# ---------------------------------------------------------------------------
+_GEAK_GELUPOLY = _geak_flag("GEAK_DIT_GELUPOLY")
+_GEAK_QRCP = _geak_flag("GEAK_DIT_QRCP")
+try:
+    _GEAK_F8 = torch.float8_e4m3fn            # OCP e4m3 -- gfx950, NOT e4m3fnuz
+except Exception:                             # pragma: no cover
+    _GEAK_F8 = None
+_GEAK_F8MAX = 448.0
+_geak_q8_slot = [None]
+_geak_fp8_seen = [0]
+_geak_addlnq_cache = {}
+_geak_geluq_cache = {}
+
+
+if _GEAK_TRITON_OK:
+
+    @_geak_triton.jit
+    def _geak_addln_q8_kernel(
+        X, A, G, SH, SC, R, O, OS,
+        s_bt, HW, eps, fmax,
+        RCP: _geak_tl.constexpr,
+        C: _geak_tl.constexpr, BLOCK: _geak_tl.constexpr,
+    ):
+        """`_geak_addln_kernel` with the modulated output emitted as row-scaled
+        fp8.  Every intermediate is rounded at exactly the same points; the only
+        added arithmetic is the row amax, which reuses the tile already in
+        registers, and the store is HALF the bytes."""
+        row = _geak_tl.program_id(0)
+        gt = row // HW
+        od = _geak_tl.arange(0, BLOCK)
+        m = od < C
+        x = _geak_tl.load(X + row * C + od, mask=m, other=0.0).to(_geak_tl.float32)
+        a = _geak_tl.load(A + row * C + od, mask=m, other=0.0).to(_geak_tl.float32)
+        g = _geak_tl.load(G + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        r = (x + a * g).to(R.dtype.element_ty)
+        _geak_tl.store(R + row * C + od, r, mask=m)
+        rf = _geak_tl.where(m, r.to(_geak_tl.float32), 0.0)
+        mu = _geak_tl.sum(rf, 0) / C
+        d = _geak_tl.where(m, rf - mu, 0.0)
+        var = _geak_tl.sum(d * d, 0) / C
+        y = (d * _geak_tl.rsqrt(var + eps)).to(R.dtype.element_ty).to(_geak_tl.float32)
+        sh = _geak_tl.load(SH + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        sc = _geak_tl.load(SC + gt * s_bt + od, mask=m, other=0.0).to(_geak_tl.float32)
+        o = (sh + y * sc).to(R.dtype.element_ty).to(_geak_tl.float32)
+        am = _geak_tl.maximum(_geak_tl.max(_geak_tl.abs(_geak_tl.where(m, o, 0.0)), 0), 1e-12)
+        _geak_tl.store(OS + row, am / fmax)
+        if RCP:
+            # one reciprocal per ROW instead of one fp32 divide per ELEMENT
+            _geak_tl.store(O + row * C + od,
+                           (o * (fmax / am)).to(O.dtype.element_ty), mask=m)
+        else:
+            _geak_tl.store(O + row * C + od,
+                           (o / (am / fmax)).to(O.dtype.element_ty), mask=m)
+
+    @_geak_triton.jit
+    def _geak_geluq_kernel(X, O, S, fmax,
+                           POLY: _geak_tl.constexpr, RCP: _geak_tl.constexpr,
+                           C: _geak_tl.constexpr, BLOCK: _geak_tl.constexpr):
+        """GELU + rowwise fp8 quantisation of the FF intermediate, one pass: the
+        row is held in registers so the 6.4 MB input is read once.  See the
+        GEAK_DIT_GELUPOLY / GEAK_DIT_QRCP header for the measured economics."""
+        row = _geak_tl.program_id(0)
+        od = _geak_tl.arange(0, BLOCK)
+        m = od < C
+        x = _geak_tl.load(X + row * C + od, mask=m, other=0.0).to(_geak_tl.float32)
+        if POLY:
+            # Phi(x) = 0.5 + t*P(t^2) on t = clamp(x, -4, 4); degree-13 odd
+            # minimax fit, max|Phi err| 4.4e-4.  Seven FMAs, no ocml call.
+            t = _geak_tl.minimum(_geak_tl.maximum(x, -4.0), 4.0)
+            t2 = t * t
+            p = 3.3380286468e-08
+            p = p * t2 + -2.1534260261e-06
+            p = p * t2 + 5.9239066696e-05
+            p = p * t2 + -9.2596706852e-04
+            p = p * t2 + 9.3276899275e-03
+            p = p * t2 + -6.5818945608e-02
+            p = p * t2 + 3.9878930561e-01
+            # below -4 the exact value is |gelu| < 1.3e-4; pin it to 0 so the
+            # clamped polynomial cannot leak a growing NEGATIVE tail.
+            g = _geak_tl.where(x < -4.0, 0.0, x * (0.5 + t * p))
+        else:
+            g = x * 0.5 * (1.0 + _geak_tl.math.erf(x * 0.70710678118654752))
+        gb = g.to(X.dtype.element_ty).to(_geak_tl.float32)
+        am = _geak_tl.maximum(_geak_tl.max(_geak_tl.abs(_geak_tl.where(m, gb, 0.0)), 0), 1e-12)
+        _geak_tl.store(S + row, am / fmax)
+        if RCP:
+            _geak_tl.store(O + row * C + od,
+                           (gb * (fmax / am)).to(O.dtype.element_ty), mask=m)
+        else:
+            _geak_tl.store(O + row * C + od,
+                           (gb / (am / fmax)).to(O.dtype.element_ty), mask=m)
+
+
+def _geak_fp8_w(owner, key, weight):
+    """(mat2 [K,N] column-major fp8, scale [1,N] fp32) for `weight` [N,K],
+    per-output-channel.  Cached on `owner`; never built inside a graph capture
+    (that would bake the quantisation into the replay)."""
+    c = getattr(owner, key, None)
+    if c is not None:
+        return c
+    if _GEAK_F8 is None or weight is None:
+        setattr(owner, key, False)
+        return False
+    try:
+        if torch.cuda.is_current_stream_capturing():
+            return False                       # retry outside capture, do NOT cache
+    except Exception:
+        pass
+    c = False
+    try:
+        if (weight.is_cuda and weight.ndim == 2 and weight.shape[1] % 16 == 0
+                and weight.shape[0] % 16 == 0):
+            s = (weight.float().abs().amax(1, keepdim=True) / _GEAK_F8MAX).clamp(min=1e-12)
+            q = (weight.float() / s).clamp(-_GEAK_F8MAX, _GEAK_F8MAX).to(_GEAK_F8).contiguous()
+            c = (q.t(), s.view(1, -1).float().contiguous())
+    except Exception:
+        c = False
+    setattr(owner, key, c)
+    return c
+
+
+def _geak_f8mm(x8, xs, plan):
+    return torch._scaled_mm(x8, plan[0], scale_a=xs, scale_b=plan[1],
+                            out_dtype=torch.bfloat16)
+
