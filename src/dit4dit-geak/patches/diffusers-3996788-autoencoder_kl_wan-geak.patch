--- a/diffusers/models/autoencoders/autoencoder_kl_wan.py
+++ b/diffusers/models/autoencoders/autoencoder_kl_wan.py
@@ -33,6 +33,1135 @@
 CACHE_T = 2
 
 
+# ---------------------------------------------------------------------------
+# GEAK rank-2 (T==1) degenerate-shape collapse for the Wan VAE ENCODER.
+#
+# On this workload `AutoencoderKLWan._encode` is only ever handed a tensor with
+# temporal extent 1 (`[1, 3, 1, 224, 224]`).  Everything below is an *identity*
+# on that shape, not an approximation -- see `_geak_rank2_encode_ok` for the
+# preconditions that are checked at runtime before any of it is taken.
+#
+# Kill switch: GEAK_VAE_RANK2=0 restores the general rank-3 path bit for bit.
+# (Deliberately NOT named GEAK_VAE_T1 -- that name is force-pinned to "0" by the
+#  harness; this is an independent, wider re-derivation done in source.)
+# ---------------------------------------------------------------------------
+import os as _geak_os
+
+_GEAK_RANK2 = _geak_os.environ.get("GEAK_VAE_RANK2", "1") not in ("0", "false", "False")
+
+
+def _geak_vflag(name, default="1"):
+    return str(_geak_os.environ.get(name, default)).strip() not in ("0", "false", "False", "")
+
+
+# ROUND 2 levers on the VAE encoder (both env-killable, both measured):
+#
+# GEAK_VAE_NDTYPE -- keep `WanRMS_norm` in the ACTIVATION dtype.  The encoder runs
+#   under torch.autocast(bf16) and `linalg_vector_norm` sits on autocast's
+#   `fp32_set_opt_dtype` policy, so the 22 channel-norms per encode return an fp32
+#   norm; the clamp / div / gamma-mul then all run in fp32 (double the traffic of a
+#   bf16 tensor) and a full-size fp32->bf16 `copy_` is inserted before the next conv
+#   (measured 22 x 3.65 us of cast alone, plus ~2x traffic on div+mul).  Passing an
+#   explicit `dtype=` overrides the autocast policy without any context manager.
+#   The reduction still ACCUMULATES in fp32 (ReduceOp<BFloat16, float>); only the
+#   final norm value is rounded to bf16 before the divide.
+#
+# GEAK_VAE_SDPA -- run the single WanAttentionBlock through SDPA's MATH backend.
+#   The default (triton `attn_fwd`) takes 226.9 us on 13 CTAs = 5 % of the 256 CUs
+#   for a 784-token, ONE-head, head_dim-384 attention -- the longest kernel in the
+#   whole model.  MATH is 86 us for the same shape and is torch's own reference
+#   implementation: measured against an fp64 reference its error (9.7e-4) is
+#   marginally SMALLER than the flash kernel's (1.0e-3), so this is not a numerics
+#   trade.  CHECKED FIRST that this is not a ceil-to-tile artefact: the kernel
+#   launches 13 CTAs onto 256 CUs, i.e. it is genuinely CU-starved, not tile-masked.
+#   MEASURED VERDICT: this one LOSES (+0.15..0.33 ms of geomean, twice, interleaved).
+#   The bf16-output reduce picks a worse ReduceConfig than the fp32-output one and the
+#   saved cast does not pay for it.  Kept in source, DEFAULT OFF, as a recorded dead end.
+_GEAK_VAE_NDTYPE = _geak_vflag("GEAK_VAE_NDTYPE", "0")
+_GEAK_VAE_SDPA = _geak_vflag("GEAK_VAE_SDPA")
+
+# ------------------------------------------------------------------------------
+# CAMPAIGN 2 / r2_d0 -- GEAK_VAE_ATTN2: hand-rolled 3-kernel attention for the
+# encoder's ONE mid-block self-attention.
+#
+# That attention is [1 head, 784 tokens, head_dim 384].  Every fused backend is
+# catastrophic on it because 784 queries / BLOCK_M gives ~13 CTAs on 256 CUs:
+# MEASURED in isolation (CUDA-graph replay, bf16, this box):
+#     FLASH (aotriton)   218.1 us
+#     EFFICIENT          218.4 us
+#     CUDNN              unavailable on this stack
+#     MATH (shipped)      58.0 us
+# so the tree already selects MATH via GEAK_VAE_SDPA.  But MATH costs 58 us where
+# its own three pieces, measured separately, cost 4.84 + 5.27 + 6.97 = 17.1 us --
+# torch's math path spends the rest on 4-D bmm bookkeeping and a full fp32
+# round-trip of the 784x784 score matrix (the `bfloat16tofloat32_copy_kernel`
+# nodes in the device profile).  Doing the same three ops by hand on the 2-D
+# views measures 22.1 us, i.e. -36 us for identical arithmetic.
+#
+# ARITHMETIC: the scale is folded into the GEMM epilogue via `addmm(alpha=)`
+# instead of applied as a separate bf16 multiply afterwards, so the scale is
+# applied to the fp32 accumulator before the bf16 round instead of after it.
+# That is strictly closer to the fp64 reference, and no term is added or dropped.
+# Everything else (softmax in fp32 internally, bf16 in/out) is what MATH does.
+#
+# Kill switch: GEAK_VAE_ATTN2=0 restores torch's MATH SDPA exactly.
+_GEAK_VAE_ATTN2 = _geak_vflag("GEAK_VAE_ATTN2")
+_GEAK_VAE_VERIFY = _geak_vflag("GEAK_VAE_VERIFY", "0")
+
+# ---------------------------------------------------------------------------
+# CAMPAIGN 3 / r1_d2 (memory) -- three findings from the FIRST COMPLETE device
+# census of this tree (torch.profiler, graph-off arm, every row printed, not the
+# top-35 the harness prints).  All three are FRAMEWORK-MANUFACTURED nodes in the
+# ONE encoder mid-block self-attention -- i.e. dispatches that compute nothing
+# the model asked for.
+#
+# GEAK_VAE_SMDT -- the fp32 round-trip of the 784x784 score matrix.
+#   `torch.softmax` sits on torch.autocast's `fp32_set_opt_dtype` policy, so
+#   under the encoder's bf16 autocast `torch.softmax(scores, dim=-1)` is
+#   silently rewritten to `softmax(scores, -1, dtype=torch.float32)`, which is
+#   `_softmax(scores.to(float32), ...)`.  MEASURED in the census: an
+#   `aten::copy_ [[784,784],[784,784]]` PAIR (bfloat16tofloat32_copy_kernel +
+#   bfloat16_copy_kernel, 2.65 us each eager) around a
+#   `softmax_warp_forward<float,float,float,10>` -- the up-cast before the
+#   softmax and the down-cast that autocast inserts again for the following
+#   `torch.mm(probs, v2)`, which is a bf16 op.  TWO PURE-FLOOR NODES.
+#   Passing `dtype=scores.dtype` overrides the autocast policy (at::softmax does
+#   `input.toType(*dtype)`, a NO-OP when the dtype already matches) and selects
+#   `softmax_warp_forward<BFloat16,BFloat16,float>` -- SAME fp32 accumulator,
+#   same fp32 exp/sum, one bf16 rounding on store instead of one bf16 rounding
+#   at the `mm`'s autocast cast.  BITWISE NEUTRAL by construction.
+#   Predicted fold: -2 device ops/iter in BOTH arms.
+#
+# GEAK_VAE_QKVB -- `to_qkv`'s 1152-channel bias as a separate full-tensor node.
+#   `self.to_qkv` is `nn.Conv2d(384, 1152, 1)`.  On this stack a 1x1 conv WITH a
+#   bias lowers to `aten::miopen_convolution(... , bias, ...)` followed by a
+#   SEPARATE `aten::add_ [[1,1152,28,28],[1,1152,1,1]]` (6.5 us eager, ~3.1 us of
+#   in-graph node floor) -- MIOpen does not fuse it.  In the channels-last domain
+#   the input's memory IS a dense [HW, C] row-major matrix and the 1x1 conv IS a
+#   GEMM, so `F.linear(y2d, weight.view(3C, C), bias)` computes the identical
+#   product with the bias in the hipBLASLt epilogue: ONE node, not two.
+#   Predicted fold: -1 device op/iter in BOTH arms.
+#
+# GEAK_VAE_QKVX -- the ANALYTIC bias cancellation (exact, PROVEN symbolically,
+#   worth ZERO nodes -- recorded so the next round does not re-derive it).
+#   With q=q0+bq, k=k0+bk, v=v0+bv (biases broadcast over tokens):
+#     S_ij = (q0_i+bq).(k0_j+bk) = q0_i.k0_j + bq.k0_j + [q0_i.bk + bq.bk]
+#   the bracketed pair is CONSTANT IN j, so softmax_j is invariant to it: bk
+#   cancels identically.  o_i = sum_j p_ij (v0_j+bv) = (sum_j p_ij v0_j) + bv
+#   since sum_j p_ij = 1, so bv passes through the attention unchanged and
+#   W_proj @ bv can be folded into proj.bias once, offline.  Only bq survives.
+#   THE FOLD IS EXACT AND IT SAVES NOTHING: the surviving bq still needs a bias
+#   on the qkv GEMM, and a [1152] epilogue bias costs the same as a [384] one.
+#   Shipped DEFAULT OFF -- it perturbs bf16 rounding (the bv term is now added
+#   after the proj GEMM instead of inside the attention average) for no node.
+# GEAK_VAE_VPRJ -- DELETE the output-projection GEMM by composing it into the
+#   v-block of `to_qkv`.  This is the payoff half of the analytic cancellation
+#   above, and it is EXACT in real arithmetic:
+#       o_i = sum_j p_ij (Wv y_j + bv) = Wv (sum_j p_ij y_j) + bv     (rows of p sum to 1)
+#       z_i = Wp o_i + bp = (Wp Wv)(sum_j p_ij y_j) + (Wp bv + bp)
+#   so replacing the v-block weight by  Wv' = Wp @ Wv , zeroing bv, and adding
+#   `Wp @ bv` to `proj.bias` makes the attention output ALREADY projected.  The
+#   `F.conv2d(y, proj.weight, None)` node then has nothing left to do and is
+#   deleted outright; the surviving proj.bias is already folded into the
+#   bias+residual epilogue, so it costs nothing.  Composition is done ONCE, in
+#   fp32, on the first (warm-up) forward.
+#   Predicted fold: -1 device op/iter in BOTH arms, and -0.46 GFLOP.
+# GEAK_VAE_IM2COL -- the eight stacked 384-channel 3x3 convs at 28x28 (the
+#   deepest encoder stage: down_blocks.9/10 conv1+conv2 and mid_block.resnets
+#   .0/.1 conv1+conv2) as explicit im2col + hipBLASLt GEMM.  MEASURED in
+#   isolation on this box (CUDA-graph replay, bf16 channels-last, median of 80):
+#       CK grouped_conv 3x3 pad1        21.55 us   (2.08 GFLOP -> 97 TFLOP/s)
+#       triton im2col [784,384]->[784,3456] 4.49 us
+#       hipBLASLt [784,3456]x[3456,384] 13.32 us   (-> 156 TFLOP/s)
+#   i.e. 21.55 -> 17.81 us, -3.7 us per site, -30 us per encode.  Note this is
+#   the SAME stage the census shows running at 87 TFLOP/s while the 224/112/56
+#   stages run at 250-340: the 28x28 grid is what starves the conv, and the
+#   GEMM does not care.  The other stages are LEFT ON THE CONV -- they are
+#   already efficient and their col buffers would be 15-90 MB.
+#   Kill switch: GEAK_VAE_IM2COL=0.
+_GEAK_VAE_IM2COL = _geak_vflag("GEAK_VAE_IM2COL")
+_GEAK_VAE_IM2COL_HW = int(_geak_os.environ.get("GEAK_VAE_IM2COL_HW", "784") or 784)
+_GEAK_VAE_IM2COL_C = int(_geak_os.environ.get("GEAK_VAE_IM2COL_C", "384") or 384)
+_GEAK_VAE_VPRJ = _geak_vflag("GEAK_VAE_VPRJ")
+_GEAK_VAE_SMDT = _geak_vflag("GEAK_VAE_SMDT")
+_GEAK_VAE_QKVB = _geak_vflag("GEAK_VAE_QKVB")
+_GEAK_VAE_QKVX = _geak_vflag("GEAK_VAE_QKVX", "0")
+
+# ---------------------------------------------------------------------------
+# ROUND 4 -- GEAK_VAE_FRMS: the encoder's 22 channel-norms as ONE triton kernel
+# each, with the SiLU folded in and the fp32 round-trip deleted.
+#
+# WHAT THE PROFILE SAYS (isolated, CUDA-graph-captured VAE encode on the deployed
+# [1,3,1,224,224] clip; per-iteration device us, torch.profiler):
+#     reduce_kernel<128,4,NormTwoOps>      363 us / 21   <- the 4-CTA reduction
+#     elementwise nocast (the divide)      236 us / 28
+#     type_specialized_ (x2, the gamma mul)245 us / 42
+#     silu_kernel                          125 us / 20
+#     bfloat16_copy_kernel (the fp32 cast) 121 us / 22
+#     clamp_scalar (clamp_min(1e-12))       96 us / 21
+#                                        -------------
+#                                         ~1186 us of a 2296 us region  = 52 %
+#
+# The chain per norm is SIX dispatches and ~34 bytes of HBM traffic per element:
+# `linalg_vector_norm` sits on torch.autocast's `fp32_set_opt_dtype` policy, so it
+# returns an fp32 norm, the divide promotes the whole activation to fp32, and the
+# gamma-mul + SiLU then run at DOUBLE traffic before a full-size fp32->bf16 copy
+# is inserted for the next conv.
+#
+# The fused kernel is 1 dispatch and 6 bytes/element: it reads x twice (the second
+# read is an L2 hit -- the per-program tile is a few KB), reduces sum(x^2) over the
+# channel axis in an fp32 accumulator, and writes SiLU(x * scale*gamma / |x|) in the
+# ACTIVATION dtype.  22 dispatches replace ~132.
+#
+# WHY THIS IS NOT THE `F.rms_norm` SWAP (r2_d2 measured that a LOSS): this does not
+# change which aten op computes the norm, it deletes the aten ops entirely, and with
+# them the autocast fp32 round-trip that made the rms_norm swap a wash.
+#
+# RE-DECOMPOSITION: torch runs the reduction on FOUR workgroups (1.6 % of a 256-CU
+# device) because dim=1 on [1,C,H,W] is a strided outer reduce with H*W outputs and
+# its ReduceConfig fixes the output tiling.  The kernel below splits the SPATIAL axis
+# instead -- one program per BLOCK_S contiguous pixels, the whole channel axis in
+# registers -- so the grid is 98..784 CTAs on every one of the six shapes the encoder
+# actually runs, and no cross-CTA combine is needed at all.
+#
+# NUMERICS: the reduction accumulates in fp32 exactly as `ReduceOp<BFloat16,float>`
+# does; only the summation ORDER differs.  The divide and the gamma multiply are fp32,
+# as in the reference; the single new rounding point is the fp32->bf16 store, which
+# the reference also performs one op later when autocast casts the conv input.
+#
+# Kill switch: GEAK_VAE_FRMS=0 restores the aten chain bit for bit.
+# ---------------------------------------------------------------------------
+_GEAK_VAE_FRMS = _geak_vflag("GEAK_VAE_FRMS")
+
+# ROUND 4 -- GEAK_VAE_FBIAS: torch's ROCm conv path is `aten::miopen_convolution`
+# followed by a SEPARATE full-tensor `aten::add_` for the bias (30 of them in the
+# encoder, 150 us of device time, 5 us each).  Wherever the consumer of a conv is
+# one of the fused kernels below, the bias becomes a per-channel vector argument to
+# that kernel and the `add_` disappears.  Two consumers qualify:
+#   conv1 -> norm2   (10 residual blocks)          -> PRE_BIAS in the norm kernel
+#   conv2 -> `+ h`   (10 blocks + the attention)   -> the add_bias_add kernel below
+# GEAK_VAE_FADD gates the second one independently.
+# ------------------------------------------------------------------------------
+# CAMPAIGN 2 / r1_d2 -- GEAK_VAE_CL: ONE LAYOUT DOMAIN for the rank-2 VAE encoder.
+#
+# The encoder collapses to rank-2 (F.conv2d) on a T==1 clip, and torch hands MIOpen
+# a CONTIGUOUS NCHW activation.  MIOpen's selected solvers on gfx950 are all NHWC
+# (`igemm_fwd_gtcx35_nhwc_*`, CK `grouped_conv_fwd_xdl`), so the library packs
+# NCHW->NHWC, computes, and packs back -- 67 `batched_transpose_*` device nodes,
+# 0.331 ms, ZERO arithmetic, wrapping only 22 real conv dispatches.
+#
+# Fix: run the WHOLE encoder as one channels-last domain.  Activation enters
+# channels_last, every conv weight is materialised channels_last once, and the two
+# triton epilogues (fused RMS-norm, bias+residual add) get channels-last variants
+# -- the norm's reduction then runs over the CONTIGUOUS axis.  The attention block's
+# `reshape+permute+contiguous` qkv shuffle and its inverse become free views,
+# because channels-last memory IS the [B, HW, 3C] layout SDPA wants.
+#
+# ARITHMETIC CHANGED (stated per the direction's requirement):
+#   * conv accumulation order (MIOpen NHWC-native solver vs NHWC-after-transpose);
+#   * the RMS-norm sum-of-squares reduction order (over the contiguous C axis in one
+#     pass instead of a BLOCK_C-strided two-pass accumulate).
+# Both are reduction-order changes on the same values; no term is added or dropped.
+#
+# Kill switch: GEAK_VAE_CL=0 restores the NCHW domain bit for bit.
+# GEAK_VAE_CLDBG=1 prints the in-process guard predicate + the real memory_format of
+# every conv output on the deployed path.
+_GEAK_VAE_CL = _geak_vflag("GEAK_VAE_CL")
+_GEAK_VAE_CLDBG = _geak_vflag("GEAK_VAE_CLDBG", "0")
+
+# THE SUGGESTION VARIABLE.  torch's ROCm conv picks its backend memory format in
+# `miopen_conv_suggest_memory_format`, which returns ChannelsLast ONLY when
+# `PYTORCH_MIOPEN_SUGGEST_NHWC` is truthy AND the input or the weight is already
+# channels-last.  Without it a channels-last activation is silently packed back to
+# NCHW and the request is a no-op that costs an EXTRA transpose -- measured here as
+# `cl_out=False` on every conv despite `cl_in=True` (5.12 ms vs 4.87 ms baseline).
+# MEASURED on this stack: the variable is consulted PER CALL, not at load time, so
+# setting it from python at import is sufficient AND sufficient-late.  It is scoped
+# by construction: a conv whose input and weight are both NCHW is unaffected, so
+# nothing outside this file's channels-last domain changes behaviour.
+if _GEAK_VAE_CL:
+    _geak_os.environ["PYTORCH_MIOPEN_SUGGEST_NHWC"] = "1"
+
+
+def _geak_cl4(t):
+    """Exact test: `t` is a rank-4 dense channels-last tensor (C > 1)."""
+    if t.dim() != 4:
+        return False
+    n, c, h, w = t.shape
+    if c <= 1:
+        return False
+    return t.stride() == (c * h * w, 1, w * c, c)
+
+
+def _geak_dense4(t):
+    """rank-4 and dense in EITHER layout (what the fused epilogues accept)."""
+    return t.is_contiguous() or (_GEAK_VAE_CL and _geak_cl4(t))
+
+
+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 / r3_d2 -- three node-deletion levers on the rank-2 channels-last
+# encoder.  All three are pure DISPATCH arithmetic: the encoder's 33 remaining
+# triton nodes sit at 2.06 us of in-graph launch floor each, and the isolated
+# 22-node norm chain measures 97 us against a 55 us same-bytes copy chain of
+# which ~45 us is that floor.  So the lever is deleting nodes, not widening them.
+#
+# GEAK_VAE_RNK2 -- rewrite of `_geak_rmsnorm_cl_kernel`:
+#   * C is a `tl.constexpr` (was a runtime scalar), so triton can prove the row
+#     base `s*C` is 64-B aligned and vectorise the channel run;
+#   * the channel axis is covered by TWO exact power-of-two chunks (96 = 64+32,
+#     192 = 128+64, 384 = 256+128) instead of one `next_power_of_2` tile masked
+#     down, which removed 25-33 % of dead tile lanes;
+#   * the row mask is dropped whenever BLOCK_S divides HW (every encoder HW is
+#     50176 / 12544 / 3136 / 784 = 2^k * 49, all divisible by 16).
+#   Measured on the model's exact 22-shape chain, CUDA-graph replay, rotating
+#   buffers: 97.0 us -> 85.4 us.
+#
+# GEAK_VAE_RNFUSE -- the residual add IS the next block's norm prologue.
+#   `_geak_bias_residual_add` writes `out = y + b + h`, and 8 of its 11 sites are
+#   immediately followed by an RMS-norm of that very tensor (the next residual
+#   block's `norm1`, the attention block's `norm`, or the encoder's `norm_out`).
+#   A residual block still NEEDS `out` materialised (it is its own shortcut `h`),
+#   so the fused kernel writes BOTH `out` and the normed activation -- deleting
+#   the launch and one full read of `out`.  `norm_out` is the one site whose
+#   `out` has no other consumer, so there the store is skipped entirely.
+#   Bitwise: the fused kernel rounds `y+b+h` to the activation dtype before the
+#   reduction, exactly as the two-kernel form does through memory.
+#
+# GEAK_VAE_PADF -- the 3 `WanResample` downsamplers are
+#   `nn.Sequential(ZeroPad2d((0,1,0,1)), Conv2d(k3, stride 2))`.  The pad is a
+#   full-tensor copy node.  The producing `_geak_bias_residual_add` can scatter
+#   straight into a persistent, once-zeroed [1, C, H+1, W+1] channels-last buffer
+#   whose border is never written again, so the pad node disappears.
+# ---------------------------------------------------------------------------
+_GEAK_VAE_RNK2 = _geak_vflag("GEAK_VAE_RNK2")
+_GEAK_VAE_RNFUSE = _geak_vflag("GEAK_VAE_RNFUSE")
+_GEAK_VAE_PADF = _geak_vflag("GEAK_VAE_PADF")
+# GEAK_VAE_CBF -- `conv_in`'s bias is a separate full-tensor `add_` node on the
+# ROCm conv path.  Its only consumer is the first residual block, which needs the
+# biased tensor both as `norm1`'s input and as its own identity shortcut -- so the
+# bias rides into `norm1`'s prologue as a `_GeakPending` with no residual term and
+# the add_ node disappears.
+_GEAK_VAE_CBF = _geak_vflag("GEAK_VAE_CBF")
+# GEAK_VAE_DSBF -- the same fold for the 3 `WanResample` downsampler convs.  Their
+# consumer is always the next residual block's `norm1`, and the biased tensor is
+# also that block's shortcut, so the bias travels as a `_GeakPending` exactly like
+# `conv_in`'s.  Measured in isolation, a bias on these descriptors costs a whole
+# extra `elementwise_kernel_manual_unroll` node: +3.66 us on 96x224 s2, +6.96 us on
+# the 3->96 conv_in shape.  Requires GEAK_VAE_PADF (it rides the same branch).
+_GEAK_VAE_DSBF = _geak_vflag("GEAK_VAE_DSBF")
+_GEAK_VAE_RNVERIFY = _geak_vflag("GEAK_VAE_RNVERIFY", "0")
+_GEAK_VAE_PADVERIFY = _geak_vflag("GEAK_VAE_PADVERIFY", "0")
+_GEAK_VAE_FBIAS = _geak_vflag("GEAK_VAE_FBIAS")
+_GEAK_VAE_FADD = _geak_vflag("GEAK_VAE_FADD")
+
+# ---------------------------------------------------------------------------
+# CAMPAIGN 2 / r4_d2 -- two further node/instruction levers on the rank-2
+# channels-last encoder.  Both are strictly additive statements placed AFTER the
+# `_GEAK_VAE_FBIAS` block above; nothing in that block is reordered, so the
+# import-time `PYTORCH_MIOPEN_SUGGEST_NHWC=1` that carries the whole
+# channels-last VAE win is untouched.
+#
+# GEAK_VAE_SILU2 -- instruction lane, BITWISE NEUTRAL.  `_geak_rmsn2_kernel`'s
+#   SiLU epilogue was `y * tl.sigmoid(y)`.  `tl.sigmoid` lowers to an ocml
+#   `exp` plus a per-element fp32 divide; `y * (1 / (1 + exp2(y * -log2e)))`
+#   lowers to the hardware `v_exp_f32` plus one reciprocal and is BITWISE the
+#   same value (measured max|d| = 0 over the encoder's 384x784 shape).  On the
+#   model's exact 22-norm chain, CUDA-graph replay: 76.5 -> 71.1 us.
+#
+# GEAK_VAE_ETAIL -- node lane.  The encoder tail is
+#     conv_out(384->32, k3)  ->  bias add_  ->  quant_conv(32->32, k1)
+#       ->  bias add_  ->  .contiguous()      = FIVE device nodes, 25.0 us,
+#   for 0.17 GFLOP.  conv_out is the single worst-performing conv descriptor in
+#   the encoder (9.6 TF/s) because N = 32 leaves the CK kernel nothing to do, and
+#   BOTH its bias and quant_conv's fall off the fused CK path onto a separate
+#   `elementwise_kernel_manual_unroll`.  quant_conv is 1x1 stride-1 with nothing
+#   between it and conv_out, so the pair composes EXACTLY
+#   (`W' = Wq . Wc`, `b' = Wq . bc + bq`) -- the round-3 "consecutive linears
+#   fold" rule.  One triton kernel does the k3 conv, both biases, the 32x32
+#   quant matmul and the channels-last -> NCHW repack the caller needs, in fp32
+#   throughout: 25.0 us / 5 nodes -> 10.5 us / 1 node.
+_GEAK_VAE_SILU2 = _geak_vflag("GEAK_VAE_SILU2")
+_GEAK_VAE_ETAIL = _geak_vflag("GEAK_VAE_ETAIL")
+
+# ---------------------------------------------------------------------------
